{
  "name": "skool-mcp-cli",
  "version": "0.1.0",
  "description": "Local CLI and MCP server for Skool Classroom automation.",
  "type": "module",
  "bin": {
    "skool": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
